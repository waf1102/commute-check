# Required for stable login sessions. Generate a private random value; do not deploy this placeholder.
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///commute_check.db
JOBS_DB_URL=sqlite:///jobs.db
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Docker overrides the key path to its persistent data volume.
VAPID_KEY_FILE=vapid-keys.json
# Public frontend URL; Docker defaults to localhost:3000.
ORIGIN=http://localhost:3000
